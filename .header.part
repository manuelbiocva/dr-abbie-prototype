      <img class="logo__img logo__img--light" src="assets/img/logo-white.webp" srcset="assets/img/logo-white.webp 1x, assets/img/logo-white@2x.webp 2x" width="360" height="183" alt="" aria-hidden="true" loading="eager" decoding="async">
    </a>

    <nav class="nav" aria-label="Main">
      <ul class="nav__list">
        <li class="nav__item nav__item--has-dropdown nav__item--mega">
