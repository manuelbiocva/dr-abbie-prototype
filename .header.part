          </a>
          {{MEGA_SERVICES}}

        </li>
        <li class="nav__item nav__item--has-dropdown nav__item--mega">
          <a class="nav__link" href="#" aria-expanded="false" aria-haspopup="true" aria-controls="mega-conditions">
            Conditions
            <svg class="nav__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          {{MEGA_CONDITIONS}}

        </li>
        <li class="nav__item nav__item--has-dropdown nav__item--mega">
          <a class="nav__link" href="locations.html" aria-expanded="false" aria-haspopup="true" aria-controls="mega-clinics">
            Clinics
            <svg class="nav__chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          {{MEGA_CLINICS}}

        </li>
        <li class="nav__item"><a class="nav__link" href="team.html">Meet the Team</a></li>
